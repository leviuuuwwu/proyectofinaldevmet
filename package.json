{
	"name": "proyectofinaldevmet",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"test": "npm test --workspaces --if-present",
		"check": "biome check . && tsc -p apps/api --noEmit && tsc -p tests && tsc -p tools/datagen",
		"build": "npm run build -w apps/api",
		"test:acceptance": "node --test --test-concurrency=1 \"tests/acceptance/**/*.test.ts\"",
		"migrate": "node --env-file-if-exists=.env apps/api/src/migrate.ts",
		"dev:api": "node --env-file-if-exists=.env --watch apps/api/src/api.ts",
		"dev:indexer": "node --env-file-if-exists=.env --watch apps/api/src/indexer.ts",
		"smoke": "node tests/smoke.ts",
		"db:reset": "docker compose down -v && docker compose up -d --wait db && npm run migrate"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leviuuuwwu/proyectofinaldevmet.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"bugs": {
		"url": "https://github.com/leviuuuwwu/proyectofinaldevmet/issues"
	},
	"homepage": "https://github.com/leviuuuwwu/proyectofinaldevmet#readme",
	"private": true,
	"engines": {
		"node": ">=24 <25"
	},
	"workspaces": [
		"apps/*",
		"tests",
		"tools/*"
	],
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "24.19.2",
		"@types/pg": "8.23.1",
		"typescript": "7.0.2"
	}
}
