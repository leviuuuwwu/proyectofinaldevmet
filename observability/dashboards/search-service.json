{
	"id": null,
	"uid": "search-service",
	"title": "Search — Servicio",
	"description": "Salud de la API del buscador: tráfico, errores 5xx, latencia y escrituras. Métricas del contrato docs/contracts/telemetry.md (MET-03, MET-05).",
	"tags": [
		"search"
	],
	"timezone": "browser",
	"editable": true,
	"graphTooltip": 1,
	"schemaVersion": 39,
	"version": 1,
	"refresh": "30s",
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"annotations": {
		"list": []
	},
	"links": [
		{
			"title": "Dashboards del buscador",
			"type": "dashboards",
			"tags": [
				"search"
			],
			"asDropdown": true,
			"includeVars": true,
			"keepTime": true
		}
	],
	"templating": {
		"list": [
			{
				"name": "datasource",
				"label": "Fuente de datos",
				"type": "datasource",
				"query": "prometheus",
				"current": {},
				"hide": 0,
				"refresh": 1,
				"regex": ""
			},
			{
				"name": "namespace",
				"label": "Entorno (namespace)",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "${datasource}"
				},
				"query": {
					"query": "label_values(app_build_info, namespace)",
					"refId": "ns"
				},
				"definition": "label_values(app_build_info, namespace)",
				"includeAll": true,
				"multi": true,
				"current": {
					"selected": true,
					"text": "All",
					"value": "$__all"
				},
				"refresh": 2,
				"sort": 1,
				"hide": 0
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Solicitudes/s",
			"description": "Solicitudes por segundo. Todas las rutas de la API.",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 0,
				"y": 0
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"editorMode": "code",
					"expr": "sum(rate(http_server_request_duration_seconds_count{namespace=~\"$namespace\"}[$__rate_interval]))",
					"legendFormat": "",
					"range": true,
					"refId": "A",
					"instant": false
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							}
						]
					},
					"color": {
						"mode": "thresholds"
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"colorMode": "background",
				"graphMode": "area",
				"textMode": "auto",
				"justifyMode": "auto",
				"orientation": "auto"
			}
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Errores 5xx",
			"description": "Porcentaje de respuestas 5xx. La alerta SearchApiHighErrorRate dispara por encima de 5 % durante 5 minutos.",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 4,
				"y": 0
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"editorMode": "code",
					"expr": "(sum(rate(http_server_request_duration_seconds_count{namespace=~\"$namespace\",status_class=\"5xx\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{namespace=~\"$namespace\"}[$__rate_interval]))",
					"legendFormat": "",
					"range": true,
					"refId": "A",
					"instant": false
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit",
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "yellow",
								"value": 0.01
							},
							{
								"color": "red",
								"value": 0.05
							}
						]
					},
					"color": {
						"mode": "thresholds"
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"colorMode": "background",
				"graphMode": "area",
				"textMode": "auto",
				"justifyMode": "auto",
				"orientation": "auto"
			}
		},
