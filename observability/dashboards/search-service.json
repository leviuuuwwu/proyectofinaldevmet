					"editorMode": "code",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=~\"$namespace\",route=\"/search\"}[$__rate_interval])))",
					"legendFormat": "",
					"range": true,
					"refId": "A",
