			"type": "stat",
			"title": "p95 de /search",
			"description": "Latencia p95 de la búsqueda. La alerta SearchLatencyHigh dispara por encima de 1 s durante 10 minutos.",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
