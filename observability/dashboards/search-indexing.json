					"editorMode": "code",
					"expr": "sum(rate(index_events_processed_total{namespace=~\"$namespace\",result=\"applied\"}[$__rate_interval]))",
					"legendFormat": "",
					"range": true,
					"refId": "A",
					"instant": false
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							}
						]
					},
					"color": {
						"mode": "thresholds"
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"colorMode": "background",
				"graphMode": "area",
				"textMode": "auto",
				"justifyMode": "auto",
				"orientation": "auto"
			}
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Errores/s",
			"description": "Errores de indexación por segundo. Eventos que fallaron al aplicarse. La alerta SearchIndexerErrors dispara si es > 0 durante 5 minutos.",
