{
	"id": null,
	"uid": "search-indexing",
	"title": "Search — Indexación y reconstrucción",
	"description": "Consistencia eventual entre el catálogo y el índice de búsqueda: outbox, retraso, errores y reconstrucciones (MET-03, MET-06, MET-07).",
	"tags": [
		"search"
	],
	"timezone": "browser",
	"editable": true,
	"graphTooltip": 1,
	"schemaVersion": 39,
	"version": 1,
	"refresh": "30s",
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"annotations": {
		"list": []
	},
	"links": [
		{
			"title": "Dashboards del buscador",
			"type": "dashboards",
			"tags": [
				"search"
			],
			"asDropdown": true,
			"includeVars": true,
			"keepTime": true
		}
	],
	"templating": {
		"list": [
			{
				"name": "datasource",
				"label": "Fuente de datos",
				"type": "datasource",
				"query": "prometheus",
				"current": {},
				"hide": 0,
				"refresh": 1,
				"regex": ""
			},
			{
				"name": "namespace",
				"label": "Entorno (namespace)",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "${datasource}"
				},
				"query": {
					"query": "label_values(app_build_info, namespace)",
					"refId": "ns"
				},
				"definition": "label_values(app_build_info, namespace)",
				"includeAll": true,
				"multi": true,
				"current": {
					"selected": true,
					"text": "All",
					"value": "$__all"
				},
				"refresh": 2,
				"sort": 1,
				"hide": 0
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Pendientes",
			"description": "Eventos pendientes (outbox). index_outbox_pending. La alerta SearchIndexOutboxBacklog dispara por encima de 500 durante 10 minutos. Sube mientras corre una reconstrucción (ADR 0002).",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 0,
				"y": 0
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"editorMode": "code",
					"expr": "sum(index_outbox_pending{namespace=~\"$namespace\"})",
					"legendFormat": "",
					"range": true,
					"refId": "A",
					"instant": false
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "yellow",
								"value": 100
							},
							{
								"color": "red",
								"value": 500
							}
						]
					},
					"color": {
						"mode": "thresholds"
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"colorMode": "background",
				"graphMode": "area",
				"textMode": "auto",
				"justifyMode": "auto",
				"orientation": "auto"
			}
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Retraso p95",
			"description": "Retraso de indexación p95. Desde el commit en el catálogo hasta que se ve en /search. La alerta SearchIndexLagHigh dispara por encima de 30 s durante 10 minutos.",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 4,
				"y": 0
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"editorMode": "code",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(index_lag_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
					"legendFormat": "",
					"range": true,
					"refId": "A",
					"instant": false
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "yellow",
								"value": 5
							},
							{
								"color": "red",
								"value": 30
							}
						]
					},
					"color": {
						"mode": "thresholds"
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"colorMode": "background",
				"graphMode": "area",
				"textMode": "auto",
				"justifyMode": "auto",
				"orientation": "auto"
			}
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Aplicados/s",
			"description": "Eventos aplicados por segundo. Caudal del indexer.",
