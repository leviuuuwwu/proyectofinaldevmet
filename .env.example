# Ejemplo local. Copiar a .env (ignorado por git). Todos los valores son ficticios.
APP_ENV=dev
DATABASE_URL=postgres://search:search-dev-password@localhost:5432/search
# Tokens dev: reader → dev-reader-token, editor → dev-editor-token, admin → dev-admin-token
AUTH_TOKENS_JSON=[{"sub":"dev-reader","role":"reader","sha256":"47beeb95da92ee9485a13c613b44b1dd7ff064c2c2815902e1c2e6d765b3c8ad"},{"sub":"dev-editor","role":"editor","sha256":"aa13a9b40cd80db012113897d813e1c8754f1bbe4b3b27e5b1b7f064997b728f"},{"sub":"dev-admin","role":"admin","sha256":"1734d503f6aa6a047c36d113cbad769f719c93784b469b771c4c3e7c63adbefd"}]
LOG_LEVEL=info
OTEL_SERVICE_NAME=search-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
INDEXER_BATCH_SIZE=100
INDEXER_POLL_MS=1000
INDEXER_MAX_ATTEMPTS=5
# Solo docker-compose
POSTGRES_USER=search
POSTGRES_PASSWORD=search-dev-password
POSTGRES_DB=search
