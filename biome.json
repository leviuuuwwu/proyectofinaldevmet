{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.json",
			"!**/package.json",
			"!**/package-lock.json",
			"!**/tsconfig.json",
			"!node_modules",
			"!.claude"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true
	}
}
