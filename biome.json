{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"apps/**/*.ts",
			"apps/**/*.js",
			"apps/**/*.json",
			"package.json",
			"!apps/**/dist",
			"!**/node_modules"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true
	}
}
