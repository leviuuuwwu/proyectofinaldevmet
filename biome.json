{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": ["**/*.ts", "**/*.json", "!package.json", "!package-lock.json", "!node_modules/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	}
}
