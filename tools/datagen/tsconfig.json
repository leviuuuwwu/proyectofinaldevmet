{
	"compilerOptions": {
		"module": "nodenext",
		"target": "es2024",
		"lib": ["es2024", "dom"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	},
	"include": ["**/*.ts"]
}
